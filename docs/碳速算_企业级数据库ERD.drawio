rap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="1020" width="1555" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="06 因子、气体与方法版本" id="page06"><mxGraphModel dx="1450" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1120" background="#f6f9fb"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header-accent" value="" style="rounded=0;fillColor=#126057;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry x="42" y="47" width="5" height="49" as="geometry" /></mxCell><mxCell id="heading" value="06  因子、气体与方法版本" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#162e41;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="61" y="46" width="1500" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="管理官方、研究、供应商及企业自建因子，并固定计算用因子组合和 GWP。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61" y="89" width="1500" height="30" as="geometry" /></mxCell><mxCell id="footer-line" value="" style="rounded=0;fillColor=#aec1cf;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry x="41" y="1052" width="1558" height="1" as="geometry" /></mxCell><mxCell id="notes" value="同一因子在不同年份、地区、单位或核算口径下分别有版本。组合引用已发布版本。按气体系数与已合并的 CO₂e 系数分开。  |  带 § 的字段按编号定位关联表。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="1060" width="1556" height="28" as="geo