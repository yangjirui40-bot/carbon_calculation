Space=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#162e41;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="61" y="46" width="1500" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="登记配额、办理授权转移并核对来源及余额。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61" y="89" width="1500" height="30" as="geometry" /></mxCell><mxCell id="footer-line" value="" style="rounded=0;fillColor=#aec1cf;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry x="41" y="1052" width="1558" height="1" as="geometry" /></mxCell><mxCell id="notes" value="配额按 kgCO₂e 计量，兼容同企业内部转配额与授权企业间转移。每笔确认产生两侧流水，市场清结算单独验证。  |  带 § 的字段按编号定位关联表。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="1060" width="1556" height="28" as="geometry" /></mxCell><mxCell id="folio" value="碳速算　数据库目标模型 · 设计审阅　/　13" style="text;html=0;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#445a6d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="1089" width="1553" height="24" as="geometry" /></mxCell><mxCell id="t_quota_accounts" value="" style="group;connectable=1;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="296" y="548" width="356" height="186" as="geometry" /></mxCell><mxCell id="t_quota_accounts_background" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#aec1cf;connectable=0;" vertex="1" parent="t_quota_accounts"><mxGeometry x="0" y="0" width="356" height="186" as="geometry" /></mxCell><mxCell id="t_quota_accounts_header" value="" style="rounded=0;fillColor=#e7f1f5;