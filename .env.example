# 碳速算平台后端环境配置示例。复制为 .env 并按需修改。
APP_NAME=碳速算平台后端
APP_VERSION=2.0.0
API_PREFIX=/api/v1

# PostgreSQL 连接（默认指向 WSL Docker 中的 carbonspeed-db 容器）
DATABASE_URL=postgresql+psycopg2://carbonspeed:carbonspeed_2026_Db_x7KpQ2@localhost:5433/carbonspeed

# JWT
SECRET_KEY=please-change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 敏感数据 AES-256-GCM 加密密钥（为空时由 SECRET_KEY 派生）
DATA_ENC_KEY=

# 限流（每 IP 每分钟请求数）
RATE_LIMIT_PER_MINUTE=120

# 存储：local | s3（s3 需安装 boto3）
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- AI 引擎 ----------
# 模型缓存目录与下载镜像
MODELS_CACHE_DIR=models_cache
HF_ENDPOINT=https://hf-mirror.com
# OCR：rapidocr(真实 PP-OCRv4) | mock(演示)
OCR_ENGINE=rapidocr
# 多模态模型与语义对齐模型（真实权重，首次使用自动下载）
LAYOUT_MODEL=microsoft/layoutlmv3-base-chinese
SER_MODEL=Wulolo/layoutxlm-finetuned-xfund-zh
SBERT_MODEL=BAAI/bge-small-zh-v1.5
# POMDP-LLM 大模型推理机（OpenAI 兼容接口，如 DeepSeek；留空则用内置勾稽规则）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 算法版本
ALGORITHM_VERSION=carbon-engine-v0.5

# 演示排放因子 CSV
FACTOR_CSV=algorithm_pkg/data/demo_factors.csv

# CORS（逗号分隔；* 表示允许所有来源）
CORS_ORIGINS=*

# 首次建库默认管理员
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_EMAIL=admin@carbonspeed.local
